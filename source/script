    NotificationSoundsEnabled = state
end)

local NotificationsHidden = false
UIManagementGroup:AddToggle("DisableNotifications", {
    Text = "Hide Notifications",
    Default = false,
})
Toggles.DisableNotifications:OnChanged(function(state)
    NotificationsHidden = state
end)

UIManagementGroup:AddInput("NotificationSoundInput", {
    Text = "Custom Notification SoundID",
    Default = "",
    Numeric = true,
    Finished = true,
    ClearTextOnFocus = false,
    Placeholder = "e.g. 6518811702",
    Callback = function(value)
        local id = tostring(value):match("%d+")
        if id and #id > 0 then
            SelectedNotificationSound = tonumber(id)
        else
            SelectedNotificationSound = DefaultNotificationSound
        end
    end,
})

local function PlayNotificationSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. tostring(soundId):gsub("rbxassetid://", "")
    sound.Volume = 1
    sound.Parent = SoundService
    sound:Play()
    Debris:AddItem(sound, 5)
end

local OriginalNotify = Library.Notify
Library.Notify = function(self, args, ...)
    local soundId
    if type(args) == "table" then
        soundId = args.SoundId
    else
        soundId = select(2, ...)
    end
    soundId = soundId or SelectedNotificationSound

    if NotificationsHidden then
        if NotificationSoundsEnabled and soundId then
            pcall(PlayNotificationSound, soundId)
        end
        return
    end

    if type(args) == "table" and not NotificationSoundsEnabled then
        args.SoundId = nil
    end
    return OriginalNotify(self, args, ...)
end

